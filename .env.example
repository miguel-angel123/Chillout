# ─────────────────────────────────────────────────────────────
# CHILLOUT — variables de entorno
# MODO CERO: la aplicación funciona SIN ninguna de estas claves.
# Solo DATABASE_URL es necesaria para persistir en Neon.
# ─────────────────────────────────────────────────────────────

# Proveedor de datos: 'local' (PGlite, sin red) | 'cloud' (Neon)
PROVIDER_MODE=local

# Neon Free — crea el proyecto en https://console.neon.tech/signup
# Formato: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Opcionales (adaptadores apagados por defecto) ──────────────

# Pagos: 'mock' (local, replica estados de Wompi) | 'wompi'
PAYMENTS_PROVIDER=mock
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Email: 'outbox' (escribe en .data/outbox) | 'resend'
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM=

# WhatsApp: 'wa_me' (gratis, ilimitado) | 'cloud_api' (cobra por mensaje)
WHATSAPP_PROVIDER=wa_me
WHATSAPP_NUMBER=573000000000
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=

# Web Push (gratis, VAPID propio). Genera con: pnpm push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@chillout.co

# Storage de binarios 3D: 'local' (public/media/generated) | 's3' | 'neon'
STORAGE_PROVIDER=local

# 3D generativo (opcional; sin clave se usa la malla procedural local)
THREED_PROVIDER=procedural
TRIPO_API_KEY=
MESHY_API_KEY=

# Observabilidad (opcional)
SENTRY_DSN=

# Panel del gerente (/admin). CAMBIA la contraseña antes de publicar.
# Usa comillas si la contraseña contiene # o espacios.
ADMIN_PASSWORD=""
# Cadena larga y aleatoria para firmar la cookie de sesión.
ADMIN_SECRET=
